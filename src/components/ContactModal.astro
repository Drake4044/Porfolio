---
// Botón flotante "Contactame" + ventana con el formulario de contacto.
// El mensaje llega por Telegram, mail y al panel en vivo (función /api/contacto).
// Si existe public/cv.pdf, aparece también el botón "Descargar CV".
// @ts-ignore: el proyecto no instala los tipos de Node; fs solo se usa al compilar
import fs from 'node:fs'
const hasCV = fs.existsSync('public/cv.pdf')
---

<button type="button" class="contact-fab" data-contact-open aria-haspopup="dialog" aria-controls="contact-modal">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 9h8"/><path d="M8 13h6"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z"/></svg>
  <span>Contactame</span>
</button>

<div class="contact-modal" id="contact-modal" role="dialog" aria-modal="true" aria-labelledby="contact-title" hidden>
  <div class="contact-backdrop" data-contact-close></div>
  <div class="contact-card">
    <button type="button" class="contact-x" data-contact-close aria-label="Cerrar">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>
    </button>

    <div data-contact-form-view>
      <h2 id="contact-title" class="contact-title">¡Hablemos! 👋</h2>
      <p class="contact-intro">Contame en qué puedo ayudarte y te respondo lo antes posible.</p>
      <form class="contact-form" data-contact-form novalidate>
        <div class="contact-row">
          <label>Nombre<input name="nombre" autocomplete="name" required minlength="2" maxlength="80" /></label>
          <label>Mail<input name="email" type="email" autocomplete="email" required maxlength="160" /></label>
        </div>
        <div class="contact-row">
          <label>Empresa <span class="opt">(opcional)</span><input name="empresa" autocomplete="organization" maxlength="100" /></label>
          <label>Motivo
            <select name="motivo">
              <option>Oferta de trabajo</option>
              <option>Proyecto freelance</option>
              <option>Otro</option>
            </select>
          </label>
        </div>
        <label>Mensaje<textarea name="mensaje" rows="5" required minlength="10" maxlength="3000"></textarea></label>
        <!-- Campo trampa para robots: las personas no lo ven -->
        <label class="contact-hp" aria-hidden="true">Sitio web<input name="sitio" tabindex="-1" autocomplete="off" /></label>
        <p class="contact-error" data-contact-error role="alert"></p>
        <div class="contact-actions">
          {hasCV && (
            <a class="contact-cv" href="/cv.pdf" download="CV-Martin-Castro.pdf" data-track="Descargar CV">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"/><path d="M7 11l5 5l5 -5"/><path d="M12 4l0 12"/></svg>
              Descargar CV
            </a>
          )}
          <button type="submit" class="contact-send" data-contact-send>Enviar mensaje</button>
        </div>
      </form>
    </div>

    <div class="contact-done" data-contact-done hidden>
      <div class="contact-check">✓</div>
      <h2 class="contact-title">¡Mensaje enviado!</h2>
      <p class="contact-intro">Gracias por escribirme. Te respondo pronto a tu mail.</p>
      <button type="button" class="contact-send" data-contact-close>Cerrar</button>
    </div>
  </div>
</div>

<style is:global>
  .contact-fab {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.1rem;
    border-radius: 9999px;
    font-weight: 700;
    color: #111;
    background: linear-gradient(135deg, #facc15, #fbbf24);
    box-shadow: 0 10px 30px -6px rgb(250 204 21 / 0.55), 0 0 0 1px rgb(0 0 0 / 0.1);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s, opacity 0.3s;
    animation: fab-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.2s both;
  }
  .contact-fab svg { width: 1.3rem; height: 1.3rem; }
  .contact-fab:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 16px 36px -8px rgb(250 204 21 / 0.7); }
  .contact-fab:active { transform: scale(0.96); }
  .contact-fab::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgb(250 204 21 / 0.5);
    animation: fab-ping 3s ease-out 3s infinite;
    pointer-events: none;
  }
  @keyframes fab-in { from { opacity: 0; transform: translateY(30px) scale(0.8); } }
  @keyframes fab-ping { 0% { box-shadow: 0 0 0 0 rgb(250 204 21 / 0.5); } 40%, 100% { box-shadow: 0 0 0 14px rgb(250 204 21 / 0); } }
  @media (max-width: 480px) {
    .contact-fab { padding: 0.85rem; }
    .contact-fab span { display: none; }
  }

  .contact-modal { position: fixed; inset: 0; z-index: 90; display: grid; place-items: center; padding: 1rem; }
  .contact-modal[hidden] { display: none; }
  .contact-backdrop { position: absolute; inset: 0; background: rgb(0 0 0 / 0.7); backdrop-filter: blur(6px); animation: contact-fade 0.25s ease; }
  .contact-card {
    position: relative;
    width: 100%;
    max-width: 34rem;
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    padding: 1.75rem 1.5rem 1.5rem;
    border-radius: 1.25rem;
    color: #e5e7eb;
    background: radial-gradient(120% 120% at 50% 0%, #1d1440 0%, #0d0d16 60%);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
    animation: contact-pop 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes contact-fade { from { opacity: 0; } }
  @keyframes contact-pop { from { opacity: 0; transform: translateY(20px) scale(0.96); } }
  .contact-x { position: absolute; top: 0.75rem; right: 0.75rem; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 9999px; color: #9ca3af; transition: 0.2s; }
  .contact-x:hover { color: #facc15; background: rgb(255 255 255 / 0.08); transform: rotate(90deg); }
  .contact-x svg { width: 1.25rem; height: 1.25rem; }
  .contact-title { margin: 0 0 0.25rem; font-size: 1.5rem; font-weight: 800; color: #fff; }
  .contact-intro { margin: 0 0 1.25rem; color: #9ca3af; }
  .contact-form { display: grid; gap: 0.85rem; }
  .contact-row { display: grid; gap: 0.85rem; grid-template-columns: 1fr; }
  @media (min-width: 520px) { .contact-row { grid-template-columns: 1fr 1fr; } }
  .contact-form label { display: grid; gap: 0.35rem; font-size: 0.85rem; font-weight: 600; color: #d1d5db; }
  .contact-form .opt { font-weight: 400; color: #9ca3af; }
  .contact-form input, .contact-form select, .contact-form textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    font: inherit;
    font-weight: 400;
    color: #fff;
    border-radius: 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(0 0 0 / 0.35);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .contact-form textarea { resize: vertical; min-height: 7rem; }
  .contact-form select option { color: #111; }
  .contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus { border-color: #7c5cf0; box-shadow: 0 0 0 3px rgb(124 92 240 / 0.3); }
  .contact-form [aria-invalid="true"] { border-color: #f87171; }
  .contact-hp { position: absolute !important; left: -9999px !important; width: 1px; height: 1px; overflow: hidden; }
  .contact-error { min-height: 1.25rem; margin: 0; font-size: 0.9rem; color: #fca5a5; }
  .contact-actions { display: flex; gap: 0.75rem; justify-content: flex-end; flex-wrap: wrap; }
  .contact-send, .contact-cv {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem;
    padding: 0.7rem 1.2rem; border-radius: 0.75rem; font-weight: 700; transition: 0.2s;
  }
  .contact-send { color: #111; background: #facc15; }
  .contact-send:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .contact-send:disabled { opacity: 0.6; cursor: wait; transform: none; }
  .contact-cv { color: #e5e7eb; border: 1px solid rgb(255 255 255 / 0.15); }
  .contact-cv:hover { color: #facc15; border-color: #facc15; }
  .contact-cv svg { width: 1.1rem; height: 1.1rem; }
  .contact-done { text-align: center; padding: 1rem 0; }
  .contact-check {
    width: 4rem; height: 4rem; margin: 0 auto 1rem; border-radius: 9999px;
    display: grid; place-items: center; font-size: 2rem; color: #111; background: #22c55e;
    animation: contact-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  html.light .contact-card { color: #1f2937; background: radial-gradient(120% 120% at 50% 0%, #ede9fe 0%, #ffffff 60%); border-color: rgb(0 0 0 / 0.08); }
  html.light .contact-title { color: #111827; }
  html.light .contact-intro, html.light .contact-form .opt { color: #4b5563; }
  html.light .contact-form label { color: #374151; }
  html.light .contact-form input, html.light .contact-form select, html.light .contact-form textarea { color: #111827; background: #fff; border-color: rgb(0 0 0 / 0.15); }
  html.light .contact-cv { color: #1f2937; border-color: rgb(0 0 0 / 0.15); }
  html.light .contact-cv:hover { color: #b45309; border-color: #b45309; }
  @media (prefers-reduced-motion: reduce) {
    .contact-fab, .contact-fab::after, .contact-card, .contact-backdrop { animation: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('contact-modal')
    const form = modal?.querySelector<HTMLFormElement>('[data-contact-form]')
    if (!modal || !form) return
    // Como el visor de imágenes: la ventana vive en <body> para cubrir toda la pantalla
    if (modal.parentElement !== document.body) document.body.appendChild(modal)

    const formView = modal.querySelector<HTMLElement>('[data-contact-form-view]')!
    const doneView = modal.querySelector<HTMLElement>('[data-contact-done]')!
    const errorEl = modal.querySelector<HTMLElement>('[data-contact-error]')!
    const sendBtn = modal.querySelector<HTMLButtonElement>('[data-contact-send]')!
    let openedAt = 0
    let lastFocus: HTMLElement | null = null

    const open = () => {
      lastFocus = document.activeElement as HTMLElement
      formView.hidden = false
      doneView.hidden = true
      errorEl.textContent = ''
      modal.hidden = false
      openedAt = Date.now()
      document.documentElement.style.overflow = 'hidden'
      setTimeout(() => form.querySelector<HTMLInputElement>('input[name="nombre"]')?.focus(), 50)
    }
    const close = () => {
      if (modal.hidden) return
      modal.hidden = true
      document.documentElement.style.overflow = ''
      lastFocus?.focus({ preventScroll: true })
    }

    document.querySelectorAll('[data-contact-open]').forEach((b) => b.addEventListener('click', open))
    modal.querySelectorAll('[data-contact-close]').forEach((b) => b.addEventListener('click', close))
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') close() }
    document.addEventListener('keydown', onKey)

    const fieldError = (name: string, msg: string) => {
      const el = form.elements.namedItem(name) as HTMLInputElement
      el.setAttribute('aria-invalid', 'true')
      el.focus()
      errorEl.textContent = msg
    }

    form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'))
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      errorEl.textContent = ''
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>
      if ((data.nombre ?? '').trim().length < 2) return fieldError('nombre', 'Escribí tu nombre.')
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test((data.email ?? '').trim())) return fieldError('email', 'Revisá tu mail.')
      if ((data.mensaje ?? '').trim().length < 10) return fieldError('mensaje', 'Contame un poco más (mínimo 10 caracteres).')

      sendBtn.disabled = true
      sendBtn.textContent = 'Enviando…'
      let visita = ''
      try { visita = sessionStorage.getItem('pf-visit-key') ?? '' } catch {}
      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...data, tiempo: Date.now() - openedAt, visita }),
        })
        const out = await res.json().catch(() => ({}))
        if (!res.ok) throw new Error(out.error || 'No se pudo enviar.')
        form.reset()
        formView.hidden = true
        doneView.hidden = false
        doneView.querySelector<HTMLButtonElement>('button')?.focus()
      } catch (err) {
        errorEl.textContent = `${(err as Error).message} También podés escribirme a martincastro4044@gmail.com`
      } finally {
        sendBtn.disabled = false
        sendBtn.textContent = 'Enviar mensaje'
      }
    })

    document.addEventListener('astro:before-swap', () => document.removeEventListener('keydown', onKey), { once: true })
  })
</script>
