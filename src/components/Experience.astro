---
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE = [
    {
        title: "Frontend Developer / QA Tester",
        company: "Carta AI",
        description: 
        "Implementé el Front-End de su landing page, panel admin y tambien su e-commerce, realizando testing de flujos y mejoras UX/UI, aumentando la eficiencia operativa y la conversión digital.",
        date: "Febrero - Abril 2025"
    },
    {
        title: "Full Stack Developer",
        company: "Soy Henry",
        description: 
        "Estudio intensivo como Programador / Desarrollador Web Full Stack utilizando tecnologías como: HTML, CSS, JavaScript, React, Redux, PostgreSQL, Node.js, Express y MySQL.",
        date: "Enero 2023"
    },
    {
        title: "JavaScript Developer",
        company: "Coder House",
        description: 
        "Fundamentos avanzados del lenguaje de programación más usado en la actualidad. jQuery, AJAX, Librerías, Frameworks y mas.",
        date: "Mayo 2022"
    },
]
---

<div class="relative">
    <ol class="relative border-s border-gray-200 dark:border-gray-700 ml-5">  
        {
            EXPERIENCE.map((experiencie, index) => (
                <>
                    <li class="mb-10 ms-[1.05rem] experience-item opacity-0 -translate-x-24 transition-all duration-1000">
                        <ExperienceItem {...experiencie} />
                        {index < EXPERIENCE.length - 1 && (
                            <div class="scroll-arrow md:hidden absolute left-1/2 -translate-x-1/2 flex justify-center" style="bottom: -2rem" data-index={index}>
                                <svg 
                                    xmlns="http://www.w3.org/2000/svg" 
                                    class="icon icon-tabler icon-tabler-arrow-down" 
                                    width="24" 
                                    height="24" 
                                    viewBox="0 0 24 24" 
                                    stroke-width="2" 
                                    stroke="currentColor" 
                                    fill="none" 
                                    stroke-linecap="round" 
                                    stroke-linejoin="round"
                                >
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M12 5l0 14" />
                                    <path d="M18 13l-6 6" />
                                    <path d="M6 13l6 6" />
                                </svg>
                            </div>
                        )}
                    </li>
                </>
            ))
        }                
    </ol>
</div>

<style>
    @keyframes floatingArrow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(10px); }
    }

    @keyframes hideArrow {
        0% { 
            opacity: 1;
        }
        50% { 
            opacity: 0.5;
        }
        100% { 
            opacity: 0;
        }
    }

    @keyframes showArrow {
        0% { 
            opacity: 0;
        }
        50% { 
            opacity: 0.5;
        }
        100% { 
            opacity: 1;
        }
    }

    .scroll-arrow {
        animation: floatingArrow 1.5s ease-in-out infinite;
        color: rgb(250 204 21);
        opacity: 1;
        transition: none;
    }

    .scroll-arrow.hiding {
        animation: hideArrow 0.8s ease-in-out forwards;
    }

    .scroll-arrow.showing {
        animation: showArrow 0.8s ease-in-out forwards;
    }

    @media (max-width: 768px) {
        .scroll-arrow {
            margin-bottom: 0;
        }
    }
</style>

<script>
    const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: [0.5, 0.1]
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            const item = entry.target;
            const itemIndex = Array.from(document.querySelectorAll('.experience-item')).indexOf(item);
            const prevArrow = document.querySelector(`.scroll-arrow[data-index="${itemIndex - 1}"]`);

            if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
                // Animación de apertura del ítem
                item.classList.remove('opacity-0', '-translate-x-24');
                item.classList.add('opacity-100', 'translate-x-0');

                // Ocultar la flecha del ítem anterior cuando este ítem se abre
                if (prevArrow instanceof HTMLElement && !prevArrow.classList.contains('hiding')) {
                    prevArrow.classList.remove('showing');
                    prevArrow.classList.add('hiding');
                    setTimeout(() => {
                        prevArrow.style.display = 'none';
                    }, 800);
                }
            } else if (!entry.isIntersecting || entry.intersectionRatio <= 0.1) {
                // Animación de cierre del ítem
                item.classList.add('opacity-0', '-translate-x-24');
                item.classList.remove('opacity-100', 'translate-x-0');

                // Mostrar la flecha del ítem anterior cuando este ítem se cierra
                if (prevArrow instanceof HTMLElement) {
                    prevArrow.style.display = 'flex';
                    prevArrow.classList.remove('hiding');
                    prevArrow.classList.add('showing');
                    setTimeout(() => {
                        prevArrow.classList.remove('showing');
                    }, 800);
                }
            }
        });
    }, observerOptions);

    // Observar todos los items de experiencia
    document.querySelectorAll('.experience-item').forEach(item => {
        observer.observe(item);
    });

    // Verificar el estado inicial al cargar la página
    window.addEventListener('load', () => {
        const items = Array.from(document.querySelectorAll('.experience-item'));
        items.forEach((item, index) => {
            const rect = item.getBoundingClientRect();
            const isVisible = rect.top < window.innerHeight * 0.5;
            const prevArrow = document.querySelector(`.scroll-arrow[data-index="${index - 1}"]`);

            if (prevArrow instanceof HTMLElement) {
                if (isVisible) {
                    prevArrow.classList.add('hiding');
                    prevArrow.style.display = 'none';
                } else {
                    prevArrow.style.display = 'flex';
                    prevArrow.classList.remove('hiding');
                }
            }
        });
    });
</script>

