---
import GithubIcon from "../icons/Github.astro"
import LinkedInIcon from "../icons/LinkedIn.astro"
import AstroIcon from "../icons/AstroIcon.astro"

---


<footer class="border-t mt-10">
    <div class="mx-auto w-full max-w-screen-xl p-2 py-4 lg:py-6">
        <div class="md:flex md:justify-between">
          <div class="mb-5 md:mb-0">
              <a href="/#top" class="flex items-center">
                  <AstroIcon class="size-8 mr-1"/>
                  <span class="self-center text-xl font-semibold whitespace-nowrap">Power by Astro</span>
              </a>
          </div>
          <div class="grid grid-cols-2 gap-8 gap-x-20 mr-4 p-2">
              <div>
                <ul class="text-gray-500 dark:text-gray-400 font-medium">
                    <li>
                        <a href="/#top" class="hover:underline" aria-label="top" >Inicio</a>
                    </li>
                    <li class="my-4">
                        <a href="/#proyectos" class="hover:underline" aria-label="proyectos" >Proyectos</a>
                    </li>
                    <li>
                        <a href="/#experiencia" class="hover:underline" aria-label="experiencia" >Experiencia</a>
                    </li>
                </ul>
              </div>
              <div>
                    <ul class="text-gray-500 dark:text-gray-400 font-medium">
                        <li>
                            <a href="mailto:martincastro4044@gmail.com" class="hover:underline text-shadow transition-all duration-[0.25s] hover:text-yellow-400">Mail</a>
                        </li>
                        <li class="my-4">
                            <a href="https://github.com/Drake4044" target="_blank" class="hover:underline text-shadow transition-all duration-[0.25s] hover:text-yellow-400">Github</a>
                        </li>
                        <li>
                            <a href="https://www.linkedin.com/in/martin-daniel-castro" target="_blank" class="hover:underline text-shadow transition-all duration-[0.25s] hover:text-yellow-400">Linkedin</a>
                        </li>
                    </ul>
              </div>
          </div>
      </div>
      <hr class="my-4 border-gray-200 sm:mx-auto lg:my-6" />
      <div class="flex items-center justify-between mt-5">
          <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400"> ©2024 by Martin Castro.
          </span>
          <div class="flex sm:justify-center sm:mt-0 mr-8 gap-x-5">
              <a href="https://github.com/Drake4044" target="_blank" class="text-gray-500 hover:text-white">
                <GithubIcon class="size-5" />
              </a>
              <a href="https://www.linkedin.com/in/martin-daniel-castro" target="_blank" class="text-gray-500">
                  <LinkedInIcon class="size-5 fill-gray-500 hover:fill-white" />
              </a>
          </div>
      </div>
    </div>
</footer>

<script>
  document.addEventListener("astro:page-load", () => {
    // Función para scroll suave personalizado
    const smoothScroll = (target: Element, duration: number = 800) => {
      const headerHeight = document.getElementById('mobile-header')?.offsetHeight || 0;
      const isDesktop = window.innerWidth >= 768;
      const isHomeSection = target.id === 'top';
      const extraOffset = isDesktop && !isHomeSection ? 80 : 0; // Solo aplicar offset en desktop y no en inicio
      const targetPosition = target.getBoundingClientRect().top + window.scrollY - headerHeight + extraOffset;
      const startPosition = window.scrollY
      const distance = targetPosition - startPosition
      let startTime: number | null = null

      const animation = (currentTime: number) => {
        if (startTime === null) startTime = currentTime
        const timeElapsed = currentTime - startTime
        const progress = Math.min(timeElapsed / duration, 1)

        // Función de easing para movimiento más natural
        const easeInOutCubic = (t: number) => {
          return t < 0.5
            ? 4 * t * t * t
            : 1 - Math.pow(-2 * t + 2, 3) / 2
        }

        window.scrollTo({
          top: startPosition + (distance * easeInOutCubic(progress)),
          behavior: 'auto'
        })

        if (progress < 1) {
          requestAnimationFrame(animation)
        }
      }

      requestAnimationFrame(animation)
    }

    // Aplicar scroll suave a los enlaces de navegación del footer
    const footerNavLinks = document.querySelectorAll('footer a[href^="/#"]')
    footerNavLinks.forEach(link => {
      link.addEventListener("click", (e) => {
        e.preventDefault()
        const href = link.getAttribute("href")
        if (href?.startsWith("/#")) {
          const targetId = href.substring(2)
          const targetElement = document.getElementById(targetId)
          
          if (targetElement) {
            smoothScroll(targetElement)
            history.pushState(null, "", href)
          }
        } else {
          window.location.href = href || ""
        }
      })
    })
  })
</script>

<style>
    .text-shadow:hover {
    text-shadow: 1px 1px 5px rgb(255, 225, 0);
  }
</style>
