---
const navItems = [
  {
    title: "Inicio",
    label: "top",
    url: "/#top",
  },
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
]

const contactItem = {
    title: "Contacto",
    label: "contacto",
}
---

<header class="fixed top-0 z-20 flex items-center justify-between w-[calc(100%-2rem)] md:w-auto mx-auto mt-2 px-4 mobile-header left-1/2 -translate-x-1/2" id="mobile-header">
  <!-- Contacto móvil -->
  <button
    onclick="window.open('https://wa.me/5491170583531', '_blank')"
    class="relative md:hidden block px-2 py-2 transition text-sm font-medium text-white-600/90 contact-link"
    aria-label="Contacto WhatsApp"
  >
    Contacto
  </button>

  <!-- Navegación desktop -->
  <nav class="desktop-nav hidden md:flex relative px-6 text-sm font-medium rounded-full text-white-600/90 justify-center items-center gap-x-6">
    <!-- Indicador que se desliza hasta la sección activa -->
    <span class="nav-indicator" id="nav-indicator" aria-hidden="true"></span>
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-yellow-400 hover:text-shadow desktop-nav-link whitespace-nowrap"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <!-- Contacto desktop -->
    <button
      onclick="window.open('https://wa.me/5491170583531', '_blank')"
      class="relative block px-2 py-2 transition hover:text-yellow-400 hover:text-shadow desktop-nav-link whitespace-nowrap"
      aria-label="Contacto WhatsApp"
    >
      Contacto
    </button>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Cambiar entre modo claro y oscuro"
      title="Cambiar tema"
    >
      <svg class="icon-sun size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"/></svg>
      <svg class="icon-moon size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"/></svg>
    </button>
  </nav>

  <!-- Menú móvil actualizado -->
  <div class="md:hidden flex items-center gap-1">
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Cambiar entre modo claro y oscuro"
      title="Cambiar tema"
    >
      <svg class="icon-sun size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"/></svg>
      <svg class="icon-moon size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"/></svg>
    </button>
    <button
      id="menu-toggle"
      class="text-white p-2 focus:outline-none"
      aria-label="Toggle menu"
    >
      <svg
        id="menu-icon"
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>

    <nav
      id="mobile-menu"
      class="fixed right-[-100vw] top-[45px] w-[calc(100%-2rem)] shadow-lg transform transition-all duration-200 ease-out rounded-b-2xl border border-white/10 mobile-nav"
    >
      <div class="flex flex-col py-2">
        {
          navItems.map((link) => (
            <a
              class="relative px-4 py-3 transition text-sm font-medium text-white hover:text-yellow-400 hover:bg-white/5 first:rounded-t-none last:rounded-b-2xl mobile-menu-link"
              aria-label={link.label}
              href={link.url}
            >
              {link.title}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    // ── Botón de modo claro / oscuro ──
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const root = document.documentElement
        const toLight = !root.classList.contains("light")
        const applyTheme = () => {
          root.classList.toggle("light", toLight)
          root.classList.toggle("dark", !toLight)
          try { localStorage.setItem("theme", toLight ? "light" : "dark") } catch (e) {}
        }
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
        const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void>; finished: Promise<void> } }
        // Navegadores sin View Transitions (o con "reducir movimiento"): cambio instantáneo
        if (!doc.startViewTransition || reduceMotion) {
          applyTheme()
          return
        }
        // Un círculo del color nuevo nace en el centro de la pantalla y crece hasta cubrirla
        root.classList.add("theme-switching")
        const transition = doc.startViewTransition(applyTheme)
        transition.ready
          .then(() => {
            const radius = Math.hypot(window.innerWidth / 2, window.innerHeight / 2)
            root.animate(
              { clipPath: ["circle(0px at 50% 50%)", `circle(${radius}px at 50% 50%)`] },
              { duration: 700, easing: "cubic-bezier(0.65, 0, 0.35, 1)", pseudoElement: "::view-transition-new(root)" }
            )
          })
          .catch(() => {})
        transition.finished.finally(() => root.classList.remove("theme-switching"))
      })
    })

    // ── Indicador deslizante del menú de escritorio ──
    const indicator = document.getElementById("nav-indicator")
    const moveIndicator = () => {
      if (!indicator) return
      const active = document.querySelector<HTMLElement>(".desktop-nav a.text-yellow-400")
      if (!active) {
        indicator.style.opacity = "0"
        return
      }
      indicator.style.opacity = "1"
      indicator.style.width = `${active.offsetWidth - 16}px`
      indicator.style.transform = `translateX(${active.offsetLeft + 8}px)`
    }
    // Se mueve cada vez que cambia el link activo (las clases las pone el código de abajo)
    const navMutation = new MutationObserver(() => moveIndicator())
    document.querySelectorAll(".desktop-nav a").forEach((a) =>
      navMutation.observe(a, { attributes: true, attributeFilter: ["class"] })
    )
    window.addEventListener("resize", moveIndicator)

    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a")
    const menuToggle = document.getElementById("menu-toggle")
    const mobileMenu = document.getElementById("mobile-menu")
    const menuIcon = document.getElementById("menu-icon")
    const header = document.getElementById("mobile-header")

    // Función actualizada para cerrar el menú
    const closeMenu = () => {
      isMenuOpen = false
      if (mobileMenu) {
        mobileMenu.style.transform = "translateX(100vw)"
        mobileMenu.classList.remove('menu-open')
      }
      if (menuIcon) {
        menuIcon.innerHTML = `
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        `
      }
      if (header) {
        header.classList.remove('header-expanded')
      }
    }

    // Menú hamburguesa actualizado
    let isMenuOpen = false
    menuToggle?.addEventListener("click", (e) => {
      e.stopPropagation()
      isMenuOpen = !isMenuOpen
      if (mobileMenu) {
        if (isMenuOpen) {
          mobileMenu.style.transform = "translateX(15px)"
          mobileMenu.classList.add('menu-open')
          header?.classList.add('header-expanded')
        } else {
          mobileMenu.style.transform = "translateX(100vw)"
          mobileMenu.classList.remove('menu-open')
          header?.classList.remove('header-expanded')
        }
      }
      if (menuIcon) {
        if (isMenuOpen) {
          menuIcon.innerHTML = `
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          `
        } else {
          menuIcon.innerHTML = `
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          `
        }
      }
    })

    // Cerrar menú al hacer click fuera
    document.addEventListener("click", (e) => {
      if (isMenuOpen && !mobileMenu?.contains(e.target as Node)) {
        closeMenu()
      }
    })

    // Prevenir que clicks dentro del menú lo cierren
    mobileMenu?.addEventListener("click", (e) => {
      e.stopPropagation()
    })

    // ── Deslizamiento hacia cada sección ──
    // Arranca suave, acelera y frena suave en la sección elegida.
    // Cada cuadro usa behavior: 'instant' para no pelear con el scroll-behavior: smooth global.
    let scrollFrame: number | null = null
    let navLock = false // mientras dura el scroll, el link activo no "salta" entre secciones

    const cancelScroll = () => {
      if (scrollFrame !== null) cancelAnimationFrame(scrollFrame)
      scrollFrame = null
      navLock = false
    }
    // Si el usuario toca o usa la rueda en medio del scroll, le devolvemos el control
    window.addEventListener('wheel', cancelScroll, { passive: true })
    window.addEventListener('touchstart', cancelScroll, { passive: true })

    const getTargetTop = (target: Element) => {
      if (target.id === 'top') return 0 // Inicio: arriba de todo
      const headerHeight = document.getElementById('mobile-header')?.offsetHeight || 0
      const isDesktop = window.innerWidth >= 768
      const isHomeSection = target.id === 'top'
      const extraOffset = isDesktop && !isHomeSection ? 80 : 0
      return Math.max(0, target.getBoundingClientRect().top + window.scrollY - headerHeight + extraOffset)
    }

    const smoothScroll = (target: Element, onDone?: () => void) => {
      cancelScroll()
      const startPosition = window.scrollY
      const distance = getTargetTop(target) - startPosition
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (reduceMotion || Math.abs(distance) < 2) {
        window.scrollTo({ top: startPosition + distance, behavior: 'instant' })
        onDone?.()
        return
      }
      // Arranca suave, acelera en el medio y frena suave al llegar (easeInOutCubic).
      // La duración crece con la distancia: entre 0,5 y 0,9 segundos.
      const duration = Math.min(900, Math.max(500, Math.abs(distance) * 0.25))
      const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2)
      let startTime: number | null = null
      navLock = true

      const step = (now: number) => {
        if (startTime === null) startTime = now
        const progress = Math.min((now - startTime) / duration, 1)
        window.scrollTo({ top: startPosition + distance * easeInOutCubic(progress), behavior: 'instant' })
        if (progress < 1) {
          scrollFrame = requestAnimationFrame(step)
        } else {
          scrollFrame = null
          navLock = false
          // Corrección final por si alguna animación cambió la altura durante el viaje
          const finalTop = getTargetTop(target)
          if (Math.abs(finalTop - window.scrollY) > 4) window.scrollTo({ top: finalTop, behavior: 'instant' })
          lastActive = ''
          updateActiveLinks()
          onDone?.()
        }
      }
      scrollFrame = requestAnimationFrame(step)
    }

    // Marca un link como activo al instante (feedback inmediato al tocar)
    const setActiveLink = (sectionId: string) => {
      document.querySelectorAll('header nav a').forEach((l) => {
        const isActive = l.getAttribute('aria-label') === sectionId
        l.classList.toggle('text-yellow-400', isActive)
        l.classList.toggle('text-shadow', isActive)
      })
    }

    // Aplicar el scroll a todos los enlaces de navegación (móvil y desktop)
    const allNavLinks = document.querySelectorAll('#mobile-menu a, .desktop-nav-link')
    allNavLinks.forEach(link => {
      link.addEventListener("click", (e) => {
        e.preventDefault()
        const href = link.getAttribute("href")
        if (href?.startsWith("/#")) {
          const targetId = href.substring(2)
          const targetElement = document.getElementById(targetId)

          if (targetElement) {
            setActiveLink(targetId)
            // La sección destino aparece ya visible, sin esperar su animación de entrada
            targetElement.classList.add('section-visible')
            targetElement.classList.remove('section-hidden')
            if (isMenuOpen) closeMenu()
            smoothScroll(targetElement)
            history.pushState(null, "", href)
          }
        } else {
          window.location.href = href || ""
        }
      })
    })

    // ── Sección activa del menú ──
    // Un solo cálculo, en cada cuadro de scroll: la sección activa es la última
    // (de las que están en el menú) cuyo comienzo ya pasó la línea del 40% de la
    // pantalla. Arriba de todo siempre es "Inicio" y al llegar al final, la última.
    const navIds = Array.from(document.querySelectorAll('header nav a[aria-label]'))
      .map((a) => a.getAttribute('aria-label') ?? '')
      .filter((id, i, arr) => id && arr.indexOf(id) === i && document.getElementById(id))

    const currentSection = () => {
      if (window.scrollY < 80) return 'top'
      const nearBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4
      if (nearBottom) return navIds[navIds.length - 1]
      const line = window.innerHeight * 0.4
      let active = navIds[0]
      for (const id of navIds) {
        const el = document.getElementById(id)
        if (el && el.getBoundingClientRect().top <= line) active = id
      }
      return active
    }

    let lastActive = ''
    const updateActiveLinks = () => {
      if (navLock) return
      const active = currentSection()
      if (active === lastActive) return
      lastActive = active
      setActiveLink(active)
    }

    let ticking = false
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        ticking = false
        updateActiveLinks()
      })
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
    updateActiveLinks()

    // Observer para las secciones con animación
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const section = entry.target
        
        if (entry.isIntersecting) {
          section.classList.add('section-visible')
          section.classList.remove('section-hidden')
        } else {
          section.classList.remove('section-visible')
          section.classList.add('section-hidden')
        }
      })
    }, {
      root: null,
      rootMargin: '-10% 0px',
      threshold: 0.1
    })

    // Observar todas las secciones con data-section
    const animatedSections = document.querySelectorAll('[data-section]')
    animatedSections.forEach((section) => {
      section.classList.add('section-hidden') // Asegurar estado inicial
      sectionObserver.observe(section)
    })

    moveIndicator()

    // Cleanup mejorado
    return () => {
      navMutation.disconnect()
      cancelScroll()
      window.removeEventListener('wheel', cancelScroll)
      window.removeEventListener('touchstart', cancelScroll)
      sectionObserver.disconnect()
      window.removeEventListener('scroll', onScroll)
      window.removeEventListener('resize', onScroll)
    }
  })
</script>

<style>
  /* ── Botón de tema ── */
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    color: rgb(250 204 21);
    transition: background 0.3s, transform 0.3s;
  }
  .theme-toggle:hover {
    background: rgb(255 255 255 / 0.1);
    transform: rotate(-15deg);
  }
  .theme-toggle svg {
    position: absolute;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s;
  }
  /* En oscuro se ve la luna; en claro, el sol */
  .theme-toggle .icon-sun { opacity: 0; transform: rotate(-90deg) scale(0.5); }
  :global(html.light) .theme-toggle .icon-sun { opacity: 1; transform: none; }
  :global(html.light) .theme-toggle .icon-moon { opacity: 0; transform: rotate(90deg) scale(0.5); }
  :global(html.light) .theme-toggle { color: #b45309; }
  :global(html.light) .theme-toggle:hover { background: rgb(0 0 0 / 0.06); }

  /* ── Indicador del link activo ── */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: 4px;
    height: 2px;
    width: 0;
    opacity: 0;
    border-radius: 9999px;
    background: rgb(250 204 21);
    box-shadow: 0 0 8px rgb(250 204 21 / 0.8);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), width 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s;
    pointer-events: none;
  }

  /* ── Header en modo claro ── */
  @media (min-width: 768px) {
    :global(html.light) nav {
      animation-name: nav-shadown-light;
    }
    @keyframes nav-shadown-light {
      to {
        @apply shadow-lg ring-1 backdrop-blur ring-black/10;
        background: radial-gradient(125% 125% at 50% 30%, #fff 40%, #ddd6fe 100%);
      }
    }
  }
  @media (max-width: 767px) {
    :global(html.light) .mobile-header {
      background: radial-gradient(125% 125% at 50% 30%, #fff 40%, #ddd6fe 100%);
      --tw-ring-color: rgb(0 0 0 / 0.1);
    }
  }
  :global(html.light) .mobile-nav {
    background: radial-gradient(125% 125% at 50% 30%, #fff 40%, #ddd6fe 100%);
  }
  :global(html.light) #menu-toggle,
  :global(html.light) .mobile-menu-link,
  :global(html.light) .desktop-nav-link,
  :global(html.light) .contact-link {
    color: #1f2937;
  }
  :global(html.light) .text-shadow,
  :global(html.light) .mobile-menu-link.text-yellow-400 {
    color: #b45309;
    text-shadow: none;
  }
  :global(html.light) .contact-link {
    animation-name: contactPulseLight;
  }
  @keyframes contactPulseLight {
    0%, 100% { color: #1f2937; }
    50% { color: #b45309; }
  }
  :global(html.light) .nav-indicator {
    background: #b45309;
    box-shadow: none;
  }

  .text-shadow {
    text-shadow: 2px 2px 4px rgba(255, 225, 0, 0.7);
    color: rgb(250, 204, 21);
  }
  
  /* Estilos para desktop */
  @media (min-width: 768px) {
  nav {
    animation: nav-shadown linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur [background:radial-gradient(125%_125%_at_50%_30%,#000_40%,#63e_100%)] ring-white/10;
    }
    }

    .desktop-nav-link {
      position: relative;
      transition: all 0.3s ease;
    }

    .desktop-nav-link:hover {
      transform: translateY(-2px);
    }

    /* Asegurar que el header esté centrado en desktop */
    .mobile-header {
      max-width: fit-content;
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* Estilos para móvil */
  @media (max-width: 767px) {
    .mobile-header {
      @apply shadow-lg ring-1 backdrop-blur bg-[radial-gradient(125%_125%_at_50%_30%,#000_40%,#63e_100%)] ring-white/10;
      border-radius: 1rem;
      width: calc(100% - 2rem);
      left: 50%;
      transform: translateX(-50%);
      margin: 0.5rem auto 0;
      position: fixed;
    }
  }

  /* Actualizar estilos del menú móvil */
  .mobile-nav {
    @apply shadow-lg ring-1 bg-[radial-gradient(125%_125%_at_50%_30%,#000_40%,#63e_100%)] ring-white/10;
    border-top-right-radius: 0;
    border-top: none;
    transform: translateX(100vw);
    max-width: 12rem;
    margin-top: -1px;
    right: 0;
    backdrop-filter: none;
  }

  /* Ajustar la posición cuando el menú está abierto */
  .menu-open {
    right: 4%;
    border-top-right-radius: 0;
    border-top: 0;
    margin-top: 0;
    transform: translateX(0);
  }

  /* Actualizar estilos del header cuando el menú está abierto */
  .header-expanded {
    border-bottom-right-radius: 0;
  }

  /* Simplificar el efecto de fusión */
  .header-expanded.mobile-header {
    border-bottom-right-radius: 0;
  }

  /* Asegurar que el contenedor del menú no tenga overflow visible */
  .md:hidden {
    overflow-x: hidden;
  }

  /* Añadir una línea separadora entre los items del menú */
  #mobile-menu a:not(:last-child) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Animación para el enlace de contacto */
  .contact-link {
    animation: contactPulse 2s infinite;
  }

  @keyframes contactPulse {
    0% {
      color: rgba(255, 255, 255, 0.9);
      text-shadow: none;
    }
    50% {
      color: rgb(250, 204, 21);
      text-shadow: 2px 2px 4px rgba(255, 225, 0, 0.7);
    }
    100% {
      color: rgba(255, 255, 255, 0.9);
      text-shadow: none;
    }
  }

  /* Mejorar las transiciones de los enlaces */
  #mobile-menu a {
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  #mobile-menu a:hover {
    transform: translateX(4px);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* Animación para el enlace activo */
  #mobile-menu a.text-yellow-400 {
    color: rgb(250, 204, 21);
    text-shadow: none;
    font-weight: 500;
  }

  /* Quitar el scroll-behavior global para usar nuestra animación personalizada */
  :global(html) {
    scroll-behavior: auto;
  }

  /* Ajustar el padding superior de las secciones */
  :global(section) {
    scroll-margin-top: 60px;
    padding-top: 1rem;
  }

  @media (min-width: 768px) {
    :global(section) {
        scroll-margin-top: 80px;
        padding-top: 1.5rem;
    }
  }

  /* Mejorar la legibilidad de los enlaces del menú móvil */
  .mobile-menu-link {
    color: rgba(255, 255, 255, 0.95);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  /* Actualizar el estilo hover y activo */
  .mobile-menu-link:active {
    background: rgb(250 204 21 / 0.15);
    transform: scale(0.97);
  }
  .mobile-menu-link:hover,
  .mobile-menu-link.text-yellow-400 {
