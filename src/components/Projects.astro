---
import GitHub from "../icons/Github.astro"
import Tailwind from "../icons/Tailwind.astro"
import Link from "../icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Javascript from "../icons/Javascript.astro"
import HTML from "../icons/HTML.astro"
import CSS from "../icons/CSS.astro"
import React from "../icons/React.astro"
import Redux from "../icons/Redux.astro"
import Sequelize from "../icons/Sequelize.astro"
import Express from "../icons/Express.astro"
import Typescript from "../icons/Typescript.astro"
import Java from "../icons/Java.astro"
import Android from "../icons/Android.astro"
import Firebase from "../icons/Firebase.astro"
import MediaPipe from "../icons/MediaPipe.astro"
import GooglePlay from "../icons/GooglePlay.astro"
import ImageCarousel from "./ImageCarousel.astro"

const TAGS = {
  TAILWIND: {
    name: "Tailwind",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class: "bg-yellow-500 text-black font-bold",
    icon: Javascript,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-blue-500 text-white font-bold",
    icon: Typescript,
  },
  HTML: {
    name: "HTML",
    class: "bg-orange-400 text-black font-bold",
    icon: HTML,
  },
  CSS: {
    name: "CSS",
    class: "bg-blue-500 text-black font-bold",
    icon: CSS,
  },
  REACT: {
    name: "React",
    class: "bg-sky-600 text-black font-bold",
    icon: React,
  },
  REDUX: {
    name: "Redux",
    class: "bg-indigo-400 text-black font-bold",
    icon: Redux,
  },
  SEQUELIZE: {
    name: "Sequelize",
    class: "bg-sky-800 text-black font-bold",
    icon: Sequelize,
  },
  EXPRESS: {
    name: "Express",
    class: "bg-slate-500 text-black font-bold",
    icon: Express,
  },
}

// Badges con estilo "marca": fondo oscuro teñido, borde y brillo del color
// oficial de cada tecnología (ver .tag-brand en los estilos de abajo).
const BRAND_TAGS = {
  HTML: { name: "HTML", class: "tag-brand", color: "#E34F26", icon: HTML },
  CSS: { name: "CSS", class: "tag-brand", color: "#2965F1", icon: CSS },
  JAVASCRIPT: { name: "JavaScript", class: "tag-brand", color: "#F7DF1E", icon: Javascript },
  JAVA: { name: "Java", class: "tag-brand", color: "#F89820", icon: Java },
  ANDROID: { name: "Android", class: "tag-brand", color: "#3DDC84", icon: Android },
  FIREBASE: { name: "Firebase", class: "tag-brand", color: "#FFCA28", icon: Firebase },
  MEDIAPIPE: { name: "MediaPipe", class: "tag-brand", color: "#00ACC1", icon: MediaPipe },
}
interface Project {
  title: string
  description: string
  link: string
  github: string
  images: string[]
  tags: { name: string; class: string; icon: any; color?: string }[]
  // Opcional: link a Google Play. Si está vacío, el botón no se muestra.
  store?: string
  // "phone" muestra las capturas dentro de un marco de celular
  device?: "desktop" | "phone"
  // Opcional: marca el proyecto como "en desarrollo" y muestra un aviso
  status?: { label: string; message: string }
}

const PROJECTS: Project[] = [
  {
    title: "Pulso",
    description:
      "App de entrenamiento en casa para Android. Permite armar una rutina semanal y seguir 36 ejercicios y 17 estiramientos con un coach con voz que funciona sin internet. Usa la cámara para contar repeticiones y corregir la postura, y tiene un esquema de músculos interactivo en 2D y 3D que muestra qué trabaja cada ejercicio. El progreso se guarda en un calendario y se sincroniza con la cuenta en la nube.",
    link: "",
    github: "https://github.com/Drake4044/Pulso-app",
    // Mañana: pegar acá el link de Google Play y aparece el botón "Google Play"
    store: "",
    device: "phone",
    images: [
      "/projects/pulso/pulso-0.webp",
      "/projects/pulso/pulso-1.webp",
      "/projects/pulso/pulso-2.webp",
      "/projects/pulso/pulso-3.webp",
      "/projects/pulso/pulso-4.webp",
      "/projects/pulso/pulso-5.webp",
      "/projects/pulso/pulso-6.webp",
    ],
    tags: [
      BRAND_TAGS.HTML,
      BRAND_TAGS.CSS,
      BRAND_TAGS.JAVASCRIPT,
      BRAND_TAGS.JAVA,
      BRAND_TAGS.ANDROID,
      BRAND_TAGS.FIREBASE,
      BRAND_TAGS.MEDIAPIPE,
    ],
    status: {
      label: "En desarrollo",
      message:
        "La app está en etapa final de desarrollo y pronto va a estar disponible para descargar en Google Play.",
    },
  },
{
    title: "Carta AI - Landing Page",
    description:
      "Carta AI presenta su servicio de inteligencia artificial para restaurantes. En ella pueden encontrar toda la información sobre el producto: qué es, cómo funciona, sus beneficios y los diferentes planes de precios. Creada con la inteligencia artificial de Lovable, lo que garantiza una experiencia visual moderna, intuitiva y optimizada para convertir visitantes en clientes.",
    link: "https://www.cartaai.pe/",
    github: "",
    images: [
      "/projects/cartaAI.pe/cartaai.pe-0.webp",
      "/projects/cartaAI.pe/cartaai.pe-1.webp",
      "/projects/cartaAI.pe/cartaai.pe-2.webp",
      "/projects/cartaAI.pe/cartaai.pe-3.webp"
    ],
    tags: [TAGS.TYPESCRIPT, TAGS.REACT, TAGS.TAILWIND, TAGS.CSS],
  },
  {
    title: "Carta AI - Ecommerce",
    description:
      "El ecommerce de Carta AI permite mostrar restaurantes afiliados según la ubicacion del usuario y sus preferencias gastronómicas, facilitando la promoción de sus platos y mejorando la conexión entre clientes y comercios locales.",
    link: "https://ecommerce-hungry-hub.lovable.app",
    github: "https://github.com/cartaaipiura/ecommerce-hungry-hub.git",
    images: [
      "/projects/cartaAi-ecommerce/cartaai-ecommerce-0.webp",
      "/projects/cartaAi-ecommerce/cartaai-ecommerce-1.webp",
      "/projects/cartaAi-ecommerce/cartaai-ecommerce-2.webp",
      "/projects/cartaAi-ecommerce/cartaai-ecommerce-3.webp"
    ],
    tags: [TAGS.TYPESCRIPT, TAGS.REACT, TAGS.TAILWIND, TAGS.CSS],
  },
  {
    title: "Pokedex - Pokemon",
    description:
      "Sitio web moderno y eficiente para los fanáticos de Pokémon. Su principal función es proporcionar información detallada sobre Pokémon, utilizando su API oficial. La aplicación está diseñada para ofrecer una experiencia de usuario fluida y completa en información. Además de la posibilidad de crear a tu propio Pokémon personalizable!!",
    link: "",
    github: "https://github.com/Drake4044/PI-Henry-Pokemons",
    images: [
      "/projects/pokemon/pokemon-0.webp",
      "/projects/pokemon/pokemon-1.webp",
      "/projects/pokemon/pokemon-2.webp"
    ],
    tags: [TAGS.JAVASCRIPT, TAGS.HTML, TAGS.CSS, TAGS.REACT, TAGS.REDUX, TAGS.EXPRESS, TAGS.SEQUELIZE],
  },
  // {
  //   title: "JavaScrtipt - Tetris",
  //   description:
  //     "Aplicación web interactiva desarrollada en JavaScript que permite a los usuarios disfrutar del icónico juego de Tetris directamente desde su navegador. Diseñada con una interfaz intuitiva y controles sencillos, esta app ofrece una experiencia de juego fiel al clásico Tetris.",
  //   link: "",
  //   github: "https://github.com/Drake4044/Tetris-Game",
  //   images: [
  //     "/projects/tetris/tetris-0.webp",
  //     "/projects/tetris/tetris-1.webp",
  //     "/projects/tetris/tetris-2.webp"
  //   ],
  //   tags: [TAGS.JAVASCRIPT, TAGS.HTML, TAGS.CSS],
  // },
]---

<div class="flex flex-col gap-y-4">
  {
    PROJECTS.map(({ images, title, description, tags, link, github, store, device, status }, index) => (
      <>
        <article class="flex flex-col space-x-0 space-y-8 md:flex-row md:space-x-8 md:space-y-0 transition-all duration-100 p-4 project-card">
          <div class="w-full md:w-[45%] z-10 translate-y-36 md:translate-y-0 md:translate-x-60 transition-all duration-500 image-container">
            <div class="relative w-full transition duration-500 ease-in-out transform scale-75 md:scale-100">
              <!-- Tarjeta con inclinación 3D y brillo que sigue al mouse -->
              <div class="project-tilt relative w-full aspect-[4/3] rounded-xl overflow-hidden shadow-xl md:shadow-2xl ring-1 ring-white/10 bg-black/20" data-tilt>
                <ImageCarousel images={images} title={title} device={device} />
                <div class="project-spotlight" aria-hidden="true"></div>
              </div>
            </div>
          </div>

          <div class="w-full md:w-1/2 md:max-w-lg -translate-y-56 md:-translate-y-0 scale-0 md:scale-50 md:opacity-0 md:-translate-x-56 content-container transition-all duration-1000">
            <h3 class="text-2xl font-bold text-gray-200 flex flex-wrap items-center gap-x-3 gap-y-2">
              {title}
              {status && (
                <span class="wip-badge">
                  <span class="wip-dot" aria-hidden="true"></span>
                  {status.label}
                </span>
              )}
            </h3>
            <div class="flex flex-wrap mt-3 m-auto">
              {tags.length > 0 && (
                <ul class="grid grid-cols-3 xs:grid-cols-4 gap-2">
                  {tags.map((tag) => (
                    <li>
                      <span
                        class={`tag-pill flex justify-center items-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
                        style={tag.color ? `--brand: ${tag.color}` : undefined}
                      >
                        <tag.icon class="size-5" />
                        {tag.name}
                      </span>
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-4 text-gray-300">{description}</div>

              {status && (
                <p class="wip-note mt-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z"/><path d="M12 16h.01"/></svg>
                  <span>{status.message}</span>
                </p>
              )}

              <footer class="flex items-end justify-start mt-4 gap-x-4">
                {github && (
                  <LinkButton href={github}>
                    <GitHub class="size-6" />
                    Code
                  </LinkButton>
                )}
                {link && (
                  <LinkButton href={link}>
                    <Link class="size-4" />
                    Link
                  </LinkButton>
                )}
                {store && (
                  <LinkButton href={store}>
                    <GooglePlay class="size-5" />
                    Google Play
                  </LinkButton>
                )}
              </footer>
            </div>
          </div>
        </article>

        {index < PROJECTS.length - 1 && (
          <div class="relative h-8 md:h-0 my-10">
            <div class="project-arrow md:hidden absolute left-1/2 -translate-x-1/2 top-[25%] -translate-y-1/2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M12 5l0 14" />
                <path d="M18 13l-6 6" />
                <path d="M6 13l6 6" />
              </svg>
            </div>
          </div>
        )}
      </>
    ))
  }
</div>

<style>
  @keyframes floatingArrow {
    0%, 100% { transform: translate(-50%, -50%); }
    50% { transform: translate(-50%, calc(-50% + 10px)); }
  }
  @keyframes hideArrow {
    0% { transform: translate(-50%, -50%); opacity: 1; }
    50% { transform: translate(-50%, calc(-50% - 20px)); opacity: 0.5; }
    100% { transform: translate(-50%, calc(-50% - 30px)); opacity: 0; }
  }
  @keyframes showArrow {
    0% { transform: translate(-50%, calc(-50% - 30px)); opacity: 0; }
    50% { transform: translate(-50%, calc(-50% - 20px)); opacity: 0.5; }
    100% { transform: translate(-50%, -50%); opacity: 1; }
  }
  .project-arrow {
    animation: floatingArrow 1.5s ease-in-out infinite;
    color: rgb(250 204 21);
  }
  .project-arrow.hiding { animation: hideArrow 0.8s ease-in-out forwards; }
  .project-arrow.showing { animation: showArrow 0.8s ease-in-out forwards; }

  /* ── Efecto 3D + brillo en la tarjeta ── */
  .project-tilt {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.25s ease-out, box-shadow 0.3s;
    transform-style: preserve-3d;
  }
  .project-tilt:hover {
    box-shadow: 0 25px 50px -12px rgb(102 51 238 / 0.45);
  }
  .project-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    background: radial-gradient(400px circle at var(--mx) var(--my), rgb(250 204 21 / 0.18), transparent 45%);
    mix-blend-mode: screen;
    border-radius: inherit;
  }
  .project-tilt:hover .project-spotlight { opacity: 1; }
  /* Borde degradado animado al pasar el mouse */
  .project-tilt::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgb(250 204 21), rgb(102 51 238), transparent 60%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .project-tilt:hover::after { opacity: 1; }

  .tag-pill {
    transition: transform 0.2s;
  }
  .tag-pill:hover {
    transform: translateY(-2px) scale(1.05);
  }

  /* ── Badges con color de marca ── */
  .tag-brand {
    font-weight: 600;
    color: #f3f4f6;
    background: color-mix(in srgb, var(--brand) 16%, rgb(17 17 27 / 0.85));
    border: 1px solid color-mix(in srgb, var(--brand) 55%, transparent);
    box-shadow: inset 0 0 10px color-mix(in srgb, var(--brand) 18%, transparent);
    transition: transform 0.2s, box-shadow 0.25s, border-color 0.25s;
  }
  .tag-brand:hover {
    border-color: var(--brand);
    box-shadow: 0 0 14px color-mix(in srgb, var(--brand) 55%, transparent), inset 0 0 10px color-mix(in srgb, var(--brand) 25%, transparent);
  }
  :global(html.light) .tag-brand {
    color: #111827;
    background: color-mix(in srgb, var(--brand) 14%, #ffffff);
    border-color: color-mix(in srgb, var(--brand) 70%, #000000 10%);
    box-shadow: none;
  }

  /* ── Proyecto en desarrollo ── */
  .wip-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 9999px;
    color: rgb(250 204 21);
    background: rgb(250 204 21 / 0.12);
    border: 1px solid rgb(250 204 21 / 0.4);
  }
  .wip-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgb(250 204 21);
    animation: wip-pulse 1.6s ease-in-out infinite;
  }
  @keyframes wip-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgb(250 204 21 / 0.6); }
    50% { box-shadow: 0 0 0 6px rgb(250 204 21 / 0); }
  }
  .wip-note {
    display: flex;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    border-radius: 0.75rem;
    color: rgb(253 230 138);
    background: repeating-linear-gradient(-45deg, rgb(250 204 21 / 0.08) 0 10px, rgb(250 204 21 / 0.03) 10px 20px);
    border: 1px dashed rgb(250 204 21 / 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-tilt { transform: none !important; }
    .wip-dot { animation: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // ── Animación de entrada de cada proyecto (igual que antes) ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const article = entry.target
        const imageContainer = article.querySelector('.image-container')
        const contentContainer = article.querySelector('.content-container')
        const imageWrapper = article.querySelector('.image-container > div')
        const previousArrow = article.previousElementSibling?.querySelector('.project-arrow')

        if (entry.intersectionRatio >= 0.3 && entry.isIntersecting) {
          if (previousArrow instanceof HTMLElement && !previousArrow.classList.contains('hiding')) {
            previousArrow.classList.remove('showing')
            previousArrow.classList.add('hiding')
            setTimeout(() => { previousArrow.style.display = 'none' }, 800)
          }
          imageContainer?.classList.remove('translate-y-36', 'md:translate-x-60')
          contentContainer?.classList.remove('-translate-y-56', 'scale-0', 'md:scale-50', 'md:opacity-0', 'md:-translate-x-56')
          contentContainer?.classList.add('scale-100', 'md:scale-100', 'md:opacity-100')
          imageWrapper?.classList.remove('scale-75')
          imageWrapper?.classList.add('scale-100')
        } else if (!entry.isIntersecting) {
          if (previousArrow instanceof HTMLElement) {
            previousArrow.style.display = 'flex'
            previousArrow.classList.remove('hiding')
            previousArrow.classList.add('showing')
            setTimeout(() => previousArrow.classList.remove('showing'), 800)
          }
          imageContainer?.classList.add('translate-y-36', 'md:translate-x-60')
          contentContainer?.classList.add('-translate-y-56', 'scale-0', 'md:scale-50', 'md:opacity-0', 'md:-translate-x-56')
          contentContainer?.classList.remove('scale-100', 'md:scale-100', 'md:opacity-100')
          if (window.innerWidth < 768) {
            imageWrapper?.classList.remove('scale-100')
            imageWrapper?.classList.add('scale-75')
          }
        }
      })
    }, { threshold: [0, 0.3] })

    document.querySelectorAll('.project-card').forEach(article => observer.observe(article))

    // ── Inclinación 3D + brillo que sigue al mouse (solo desktop) ──
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (canHover && !reduceMotion) {
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          if (card.querySelector('.carousel.is-dragging')) return
          const r = card.getBoundingClientRect()
          const x = (e.clientX - r.left) / r.width
          const y = (e.clientY - r.top) / r.height
          card.style.setProperty('--ry', `${(x - 0.5) * 10}deg`)
          card.style.setProperty('--rx', `${(0.5 - y) * 10}deg`)
          card.style.setProperty('--mx', `${x * 100}%`)
          card.style.setProperty('--my', `${y * 100}%`)
        })
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--rx', '0deg')
          card.style.setProperty('--ry', '0deg')
        })
      })
    }

    // Limpieza al cambiar de página (View Transitions)
    document.addEventListener('astro:before-swap', () => {
      observer.disconnect()
    }, { once: true })
  })
</script>
