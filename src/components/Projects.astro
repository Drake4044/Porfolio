---
import GitHub from "../icons/Github.astro"
import Tailwind from "../icons/Tailwind.astro"
import Link from "../icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Javascript from "../icons/Javascript.astro"
import HTML from "../icons/HTML.astro"
import CSS from "../icons/CSS.astro"
import React from "../icons/React.astro"
import Redux from "../icons/Redux.astro"
import Sequelize from "../icons/Sequelize.astro"
import Express from "../icons/Express.astro"
import Typescript from "../icons/Typescript.astro"

const TAGS = {
  TAILWIND: {
    name: "Tailwind",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class: "bg-yellow-500 text-black font-bold",
    icon: Javascript,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-blue-500 text-white font-bold",
    icon: Typescript,
  },
  HTML: {
    name: "HTML",
    class: "bg-orange-400 text-black font-bold",
    icon: HTML,
  },
  CSS: {
    name: "CSS",
    class: "bg-blue-500 text-black font-bold",
    icon: CSS,
  },
  REACT: {
    name: "React",
    class: "bg-sky-600 text-black font-bold",
    icon: React,
  },
  REDUX: {
    name: "Redux",
    class: "bg-indigo-400 text-black font-bold",
    icon: Redux,
  },
  SEQUELIZE: {
    name: "Sequelize",
    class: "bg-sky-800 text-black font-bold",
    icon: Sequelize,
  },
  EXPRESS: {
    name: "Express",
    class: "bg-slate-500 text-black font-bold",
    icon: Express,
  },
}
const PROJECTS = [
{
    title: "Carta AI - Landing Page",
    description:
      "Carta AI presenta su servicio de inteligencia artificial para restaurantes. En ella pueden encontrar toda la información sobre el producto: qué es, cómo funciona, sus beneficios y los diferentes planes de precios. Creada con la inteligencia artificial de Lovable, lo que garantiza una experiencia visual moderna, intuitiva y optimizada para convertir visitantes en clientes.",
    link: "https://www.cartaai.pe/",
    github: "",
    images: [
      "/projects/cartaAI.pe/cartaai.pe-0.webp",
      "/projects/cartaAI.pe/cartaai.pe-1.webp",
      "/projects/cartaAI.pe/cartaai.pe-2.webp",
      "/projects/cartaAI.pe/cartaai.pe-3.webp"
    ],
    tags: [TAGS.TYPESCRIPT, TAGS.REACT, TAGS.TAILWIND, TAGS.CSS],
  },
  {
    title: "Carta AI - Ecommerce",
    description:
      "El ecommerce de Carta AI permite mostrar restaurantes afiliados según la ubicacion del usuario y sus preferencias gastronómicas, facilitando la promoción de sus platos y mejorando la conexión entre clientes y comercios locales.",
    link: "ecommerce-hungry-hub.lovable.app",
    github: "https://github.com/cartaaipiura/ecommerce-hungry-hub.git",
    images: [
      "/projects/cartaAi-ecommerce/cartaai-ecommerce-0.webp",
      "/projects/cartaAi-ecommerce/cartaai-ecommerce-1.webp",
      "/projects/cartaAi-ecommerce/cartaai-ecommerce-2.webp",
      "/projects/cartaAi-ecommerce/cartaai-ecommerce-3.webp"
    ],
    tags: [TAGS.TYPESCRIPT, TAGS.REACT, TAGS.TAILWIND, TAGS.CSS],
  },
  {
    title: "Pokedex - Pokemon",
    description:
      "Sitio web moderno y eficiente para los fanáticos de Pokémon. Su principal función es proporcionar información detallada sobre Pokémon, utilizando su API oficial. La aplicación está diseñada para ofrecer una experiencia de usuario fluida y completa en información. Además de la posibilidad de crear a tu propio Pokémon personalizable!!",
    link: "",
    github: "https://github.com/Drake4044/PI-Henry-Pokemons",
    images: [
      "/projects/pokemon/pokemon-0.webp",
      "/projects/pokemon/pokemon-1.webp",
      "/projects/pokemon/pokemon-2.webp"
    ],
    tags: [TAGS.JAVASCRIPT, TAGS.HTML, TAGS.CSS, TAGS.REACT, TAGS.REDUX, TAGS.EXPRESS, TAGS.SEQUELIZE],
  },
  {
    title: "JavaScrtipt - Tetris",
    description:
      "Aplicación web interactiva desarrollada en JavaScript que permite a los usuarios disfrutar del icónico juego de Tetris directamente desde su navegador. Diseñada con una interfaz intuitiva y controles sencillos, esta app ofrece una experiencia de juego fiel al clásico Tetris.",
    link: "",
    github: "https://github.com/Drake4044/Tetris-Game",
    images: [
      "/projects/tetris/tetris-0.webp",
      "/projects/tetris/tetris-1.webp",
      "/projects/tetris/tetris-2.webp"
    ],
    tags: [TAGS.JAVASCRIPT, TAGS.HTML, TAGS.CSS],
  },
]
---

<div class="flex flex-col gap-y-4">
  {
    PROJECTS.map(({ images, title, description, tags, link, github }, index) => (
      <>
        <article class="flex flex-col space-x-0 space-y-8 md:flex-row md:space-x-8 md:space-y-0 transition-all duration-100 p-4 project-card">
          <div class="w-full md:w-[45%] z-10 translate-y-36 md:translate-y-0 md:translate-x-60 transition-all duration-500 image-container">
            <div class="relative flex flex-col items-center w-full gap-8 transition duration-500 ease-in-out transform scale-75 md:scale-100 shadow-xl overflow-clip rounded-xl sm:rounded-xl md:shadow-2xl lg:border lg:border-gray-800">
              <div class="w-full aspect-[4/3] overflow-hidden">
                <div class="carousel-container w-full h-full relative bg-black/10">
                  <div class="carousel-track w-full h-full flex transition-transform duration-300 ease-in-out">
                    {images.map((image, imgIndex) => (
                      <div class="carousel-slide min-w-full h-full flex items-center justify-center">
                        <img 
                          alt={`${title} - imagen ${imgIndex + 1}`} 
                          class="w-full h-full object-contain transition duration-500 project-image" 
                          src={image} 
                          data-index={imgIndex}
                        />
                      </div>
                    ))}
                  </div>
                  
                  <!-- Navigation buttons -->
                  <button class="carousel-button carousel-button-prev absolute left-2 top-1/2 -translate-y-1/2 bg-black/50 text-white rounded-full p-2 opacity-0 transition-opacity duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 18l-6-6 6-6"/>
                    </svg>
                  </button>
                  <button class="carousel-button carousel-button-next absolute right-2 top-1/2 -translate-y-1/2 bg-black/50 text-white rounded-full p-2 opacity-0 transition-opacity duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 18l6-6-6-6"/>
                    </svg>
                  </button>
                  
                  <!-- Dots indicator -->
                  <div class="carousel-dots absolute bottom-2 left-1/2 -translate-x-1/2 flex space-x-2">
                    {images.map((_, dotIndex) => (
                      <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 transition-colors duration-300" data-index={dotIndex}></button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="w-full md:w-1/2 md:max-w-lg -translate-y-56 md:-translate-y-0 scale-0 md:scale-50 md:opacity-0 md:-translate-x-56 content-container transition-all duration-1000">
    <h3 class="text-2xl font-bold text-gray-200">
      {title}
    </h3>
    <div class="flex flex-wrap mt-3 m-auto grid-rows-2]">
      <ul class="grid grid-cols-3 xs:grid-cols-4 gap-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex justify-center items-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
              >
                <tag.icon class="size-5" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

      <div class="mt-4 text-gray-300">{description}</div>
      <footer class="flex items-end justify-start mt-4 gap-x-4">
          {github && (
            <LinkButton href={github}>
              <GitHub class="size-6" />
              Code
            </LinkButton>
          )}
          {link && (
            <LinkButton href={link}>
              <Link class="size-4" />
              Link
            </LinkButton>
          )}
        </footer>
    </div>
  </div>
</article>
        
        {index < PROJECTS.length - 1 && (
          <div class="relative h-8 md:h-0 my-10">
            <div class="project-arrow md:hidden absolute left-1/2 -translate-x-1/2 top-[25%] -translate-y-1/2">
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                class="icon icon-tabler icon-tabler-arrow-down" 
                width="24" 
                height="24" 
                viewBox="0 0 24 24" 
                stroke-width="2" 
                stroke="currentColor" 
                fill="none" 
                stroke-linecap="round" 
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M12 5l0 14" />
                <path d="M18 13l-6 6" />
                <path d="M6 13l6 6" />
              </svg>
            </div>
          </div>
        )}
      </>
    ))
  }
</div>

<style>
  @keyframes floatingArrow {
    0%, 100% { transform: translate(-50%, -50%); }
    50% { transform: translate(-50%, calc(-50% + 10px)); }
  }

  @keyframes hideArrow {
    0% { 
      transform: translate(-50%, -50%);
      opacity: 1;
    }
    50% { 
      transform: translate(-50%, calc(-50% - 20px));
      opacity: 0.5;
    }
    100% { 
      transform: translate(-50%, calc(-50% - 30px));
      opacity: 0;
    }
  }

  @keyframes showArrow {
    0% { 
      transform: translate(-50%, calc(-50% - 30px));
      opacity: 0;
    }
    50% { 
      transform: translate(-50%, calc(-50% - 20px));
      opacity: 0.5;
    }
    100% { 
      transform: translate(-50%, -50%);
      opacity: 1;
    }
  }

  .project-arrow {
    animation: floatingArrow 1.5s ease-in-out infinite;
    color: rgb(250 204 21);
    opacity: 1;
    transition: none;
  }

  .project-arrow.hiding {
    animation: hideArrow 0.8s ease-in-out forwards;
  }

  .project-arrow.showing {
    animation: showArrow 0.8s ease-in-out forwards;
  }

  /* Carousel styles */
  .carousel-container {
    touch-action: none;
    cursor: grab;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-track {
    will-change: transform;
    transform: translateX(0);
    transition: transform 0.3s ease-out;
    display: flex;
    align-items: center;
  }

  .carousel-slide {
    flex-shrink: 0;
    background: rgba(0, 0, 0, 0.1);
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    transition: all 0.3s ease;
  }

  .carousel-dot.active {
    background-color: rgb(250 204 21);
    transform: scale(1.2);
  }

  .project-card:hover .carousel-button {
    opacity: 1;
  }

  .grabbing {
    cursor: grabbing !important;
  }

  .project-image {
    pointer-events: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
</style>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: [0.6, 0.1]
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const article = entry.target;
      const imageContainer = article.querySelector('.image-container');
      const contentContainer = article.querySelector('.content-container');
      const projectImage = article.querySelector('.project-image');
      const imageWrapper = article.querySelector('.image-container > div');
      const previousArrow = article.previousElementSibling?.querySelector('.project-arrow');
      const carousel = article.querySelector('.carousel-container');

      if (entry.intersectionRatio >= 0.6 && entry.isIntersecting) {
        // Reset carousel to first image when project becomes visible
        if (carousel) {
          const track = carousel.querySelector('.carousel-track');
          if (track) {
            (track as HTMLElement).style.transform = 'translateX(0)';
            carousel.querySelectorAll('.carousel-dot').forEach((dot, index) => {
              dot.classList.toggle('active', index === 0);
            });
          }
        }

        if (previousArrow && previousArrow instanceof HTMLElement && !previousArrow.classList.contains('hiding')) {
          previousArrow.classList.remove('showing');
          previousArrow.classList.add('hiding');
          setTimeout(() => {
            previousArrow.style.display = 'none';
          }, 800);
        }

        if (imageContainer) {
          imageContainer.classList.remove('translate-y-36', 'md:translate-x-60');
          if (window.innerWidth < 768) {
            imageContainer.classList.add('w-full', 'md:max-w-lg');
          }
        }

        if (contentContainer) {
          contentContainer.classList.remove('-translate-y-56', 'scale-0', 'md:scale-50', 'md:opacity-0', 'md:-translate-x-56');
          contentContainer.classList.add('scale-100', 'md:scale-100', 'md:opacity-100');
        }

        if (projectImage) {
          projectImage.classList.remove('scale-150');
          projectImage.classList.add('scale-100');
        }

        if (imageWrapper) {
          if (window.innerWidth < 768) {
            imageWrapper.classList.remove('scale-75');
            imageWrapper.classList.add('scale-100');
          } else {
            imageWrapper.classList.add('scale-100');
          }
        }
      } else if (entry.intersectionRatio <= 0.1 || !entry.isIntersecting) {
        if (previousArrow && previousArrow instanceof HTMLElement) {
          previousArrow.style.display = 'flex';
          previousArrow.classList.remove('hiding');
          previousArrow.classList.add('showing');
          setTimeout(() => {
            previousArrow.classList.remove('showing');
          }, 800);
        }

        if (imageContainer) {
          imageContainer.classList.add('translate-y-36', 'md:translate-x-60');
          if (window.innerWidth < 768) {
            imageContainer.classList.remove('w-full', 'md:max-w-lg');
          }
        }

        if (contentContainer) {
          contentContainer.classList.add('-translate-y-56', 'scale-0', 'md:scale-50', 'md:opacity-0', 'md:-translate-x-56');
          contentContainer.classList.remove('scale-100', 'md:scale-100', 'md:opacity-100');
        }

        if (projectImage) {
          projectImage.classList.remove('scale-100');
          projectImage.classList.add('scale-150');
        }

        if (imageWrapper) {
          if (window.innerWidth < 768) {
            imageWrapper.classList.remove('scale-100');
            imageWrapper.classList.add('scale-75');
          } else {
            imageWrapper.classList.remove('scale-100');
          }
        }
      }
    });
  }, observerOptions);

  document.querySelectorAll('.project-card').forEach(article => {
    observer.observe(article);
  });

  window.addEventListener('load', () => {
    document.querySelectorAll('.project-card').forEach(article => {
      const rect = article.getBoundingClientRect();
      const isVisible = rect.top < window.innerHeight && rect.bottom > 0;
      const previousArrow = article.previousElementSibling?.querySelector('.project-arrow');
      
      if (previousArrow && previousArrow instanceof HTMLElement) {
        if (isVisible) {
          previousArrow.classList.remove('showing');
          previousArrow.classList.add('hiding');
          setTimeout(() => {
            previousArrow.style.display = 'none';
          }, 800);
        } else {
          previousArrow.style.display = 'flex';
          previousArrow.classList.remove('hiding');
          previousArrow.classList.add('showing');
          setTimeout(() => {
            previousArrow.classList.remove('showing');
          }, 800);
        }
      }
    });
  });

  // Carousel functionality
  document.querySelectorAll('.carousel-container').forEach(carousel => {
    let track = carousel.querySelector('.carousel-track');
    if (!track) return;

    let isDragging = false;
    let startPos = 0;
    let currentTranslate = 0;
    let currentIndex = 0;
    let prevTranslate = 0;
    let animationID = 0;
    let autoPlayInterval: number | null = null;
    let isAutoPlayPaused = false;
    let isProjectVisible = false;

    const slides = carousel.querySelectorAll('.carousel-slide');
    const dots = carousel.querySelectorAll('.carousel-dot');
    const prevButton = carousel.querySelector('.carousel-button-prev');
    const nextButton = carousel.querySelector('.carousel-button-next');
    const projectCard = carousel.closest('.project-card');

    // Prevent image dragging
    carousel.querySelectorAll('img').forEach(img => {
      img.addEventListener('dragstart', (e) => e.preventDefault());
    });

    function setPositionByIndex() {
      currentTranslate = currentIndex * -100;
      prevTranslate = currentTranslate;
      setSliderPosition();
    }

    function setSliderPosition() {
      if (!track) return;
      (track as HTMLElement).style.transform = `translateX(${currentTranslate}%)`;
      
      // Update dots
      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === currentIndex);
      });
    }

    function nextSlide() {
      if (!isProjectVisible) return;
      currentIndex = (currentIndex + 1) % slides.length;
      setPositionByIndex();
    }

    function startAutoPlay() {
      if (autoPlayInterval || !isProjectVisible) return;
      autoPlayInterval = window.setInterval(nextSlide, 3000);
    }

    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
        autoPlayInterval = null;
      }
    }

    function pauseAutoPlayTemporarily() {
      if (isAutoPlayPaused || !isProjectVisible) return;
      isAutoPlayPaused = true;
      stopAutoPlay();
      setTimeout(() => {
        isAutoPlayPaused = false;
        startAutoPlay();
      }, 5000);
    }

    function getPositionX(event: Event) {
      return event.type.includes('mouse') ? (event as MouseEvent).pageX : (event as TouchEvent).touches[0].clientX;
    }

    function touchStart(event: Event) {
      startPos = getPositionX(event);
      isDragging = true;
      animationID = requestAnimationFrame(animation);
      if (track) track.classList.add('grabbing');
      stopAutoPlay();
    }

    function touchMove(event: Event) {
      if (isDragging) {
        const currentPosition = getPositionX(event);
        const diff = (currentPosition - startPos) * 100 / (carousel as HTMLElement).offsetWidth;
        currentTranslate = prevTranslate + diff;
      }
    }

    function touchEnd() {
      isDragging = false;
      cancelAnimationFrame(animationID);
      if (track) track.classList.remove('grabbing');

      const movedBy = currentTranslate - prevTranslate;
      
      // Minimum distance for swipe
      if (Math.abs(movedBy) > 20) {
        if (movedBy < 0) {
          currentIndex = (currentIndex + 1) % slides.length;
        } else {
          currentIndex = (currentIndex - 1 + slides.length) % slides.length;
        }
      }

      setPositionByIndex();
      pauseAutoPlayTemporarily();
    }

    function animation() {
      if (isDragging) {
        // Efecto circular
        if (currentTranslate > 0) {
          currentTranslate = -((slides.length - 1) * 100);
        } else if (currentTranslate < -((slides.length - 1) * 100)) {
          currentTranslate = 0;
        }
        setSliderPosition();
        requestAnimationFrame(animation);
      }
    }

    // Event listeners
    if (track) {
      (track as HTMLElement).addEventListener('mousedown', touchStart);
      (track as HTMLElement).addEventListener('touchstart', touchStart);
      (track as HTMLElement).addEventListener('mousemove', touchMove);
      (track as HTMLElement).addEventListener('touchmove', touchMove);
      (track as HTMLElement).addEventListener('mouseup', touchEnd);
      (track as HTMLElement).addEventListener('touchend', touchEnd);
      (track as HTMLElement).addEventListener('mouseleave', touchEnd);
    }

    // Navigation buttons
    if (prevButton) {
      prevButton.addEventListener('click', () => {
        if (currentIndex === 0) {
          currentIndex = slides.length - 1;
        } else {
          currentIndex -= 1;
        }
        setPositionByIndex();
        pauseAutoPlayTemporarily();
      });
    }

    if (nextButton) {
      nextButton.addEventListener('click', () => {
        if (currentIndex === slides.length - 1) {
          currentIndex = 0;
        } else {
          currentIndex += 1;
        }
        setPositionByIndex();
        pauseAutoPlayTemporarily();
      });
    }

    // Dot navigation
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        currentIndex = index;
        setPositionByIndex();
        pauseAutoPlayTemporarily();
      });
    });

    // Initialize position
    setPositionByIndex();

    // Reset carousel position when project becomes visible
    if (projectCard) {
      const projectObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          isProjectVisible = entry.isIntersecting && entry.intersectionRatio >= 0.6;
          if (isProjectVisible) {
            currentIndex = 0;
            setPositionByIndex();
            startAutoPlay();
          } else {
            stopAutoPlay();
          }
        });
      }, { threshold: [0.6] });

      projectObserver.observe(projectCard);
    }

    // Cleanup on component unmount
    return () => {
      stopAutoPlay();
    };
  });
</script>

<style>
  .scale-175 {
    transform: scale(1.75);
  }
  
  .grabbing {
    cursor: grabbing;
  }
</style>
