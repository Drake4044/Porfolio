---
import "@fontsource-variable/onest"
import Header from '../components/Header.astro';
import Lightbox from "../components/Lightbox.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions"

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Porfolio de Martin Castro - Desarrollador y Programador Web Full Stack con experiencia en crear soluciones digitales y eficientes." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://porfolio-martin-castro.netlify.app/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="¡Hola! Soy Martin Castro, Desarrollador Web Full Stack con experiencia en crear soluciones digitales y eficientes. Transformo ideas en sitios funcionales." />
		<meta property="og:image" content="https://porfolio-martin-castro.netlify.app/opengraph.jpg" />
		<meta property="og:image:alt" content="Martin Castro - Desarrollador Web Full Stack" />
		<meta property="og:site_name" content="Portfolio Martin Castro" />
		<meta property="og:locale" content="es_ES" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://porfolio-martin-castro.netlify.app/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content="¡Hola! Soy Martin Castro, Desarrollador Web Full Stack con experiencia en crear soluciones digitales y eficientes. Transformo ideas en sitios funcionales." />
		<meta property="twitter:image" content="https://porfolio-martin-castro.netlify.app/opengraph.jpg" />
		<meta property="twitter:image:alt" content="Martin Castro - Desarrollador Web Full Stack" />

		<title>{title}</title>
		<ViewTransitions />

		<!-- Tus propias visitas no cuentan: entrá una vez a /?yo=1 desde cada dispositivo tuyo
		     (y /?yo=0 para volver a contarlas). -->
		<script is:inline>
			(function () {
				try {
					const yo = new URLSearchParams(location.search).get('yo')
					if (yo === '1') localStorage.setItem('pf-owner', '1')
					if (yo === '0') localStorage.removeItem('pf-owner')
				} catch (e) {}
			})()
		</script>

		<!-- Aplica el tema guardado ANTES de pintar la página (evita el "flash" de color) -->
		<script is:inline>
			(function () {
				const apply = () => {
					let theme = null
					try { theme = localStorage.getItem('theme') } catch (e) {}
					if (!theme) theme = 'dark' // el sitio está pensado en oscuro por defecto
					document.documentElement.classList.toggle('dark', theme === 'dark')
					document.documentElement.classList.toggle('light', theme === 'light')
				}
				apply()
				// View Transitions reemplaza el <html>: volvemos a aplicar el tema
				document.addEventListener('astro:after-swap', apply)
			})()
		</script>
	</head>
	<body class="relative text-white">
		<div class="page-bg absolute top-0 bottom-0 -z-10 min-h-screen w-full"></div>
		<Header/>
		<div transition:animate="fade">
			<slot />
		</div>
		<Footer/>
		<!-- Visor a pantalla completa: proyectos y fotos con data-zoomable -->
		<Lightbox />
	</body>
</html>
<script>
	import { initGallery } from '../scripts/gallery'
	import { initTracker } from '../scripts/tracker'

	// ── Registro anónimo de visitas (panel privado + avisos) ──
	initTracker()

	// ── Carruseles + visor a pantalla completa ──
	document.addEventListener('astro:page-load', () => {
		const destroyGallery = initGallery()
		document.addEventListener('astro:before-swap', destroyGallery, { once: true })
	})

	// ── Animación de aparición al hacer scroll ──
	// Cualquier elemento con data-reveal aparece con un fade + slide al entrar en pantalla.
	// data-reveal-delay="150" agrega un retraso en ms (útil para escalonar elementos).
	document.addEventListener('astro:page-load', () => {
		const items = document.querySelectorAll<HTMLElement>('[data-reveal]')
		const io = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return
				const el = entry.target as HTMLElement
				el.style.transitionDelay = `${el.dataset.revealDelay ?? 0}ms`
				el.classList.add('is-revealed')
				io.unobserve(el) // se anima una sola vez
			})
		}, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' })
		items.forEach((el) => io.observe(el))
		document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true })
	})
</script>

<style is:global>
	:root {
		color-scheme: dark;
	}
	html.light {
		color-scheme: light;
	}

	/* ── Fondo de la página según el tema ── */
	.page-bg {
		background: radial-gradient(125% 125% at 50% 30%, #000 40%, #63e 100%);
		transition: background 0.5s ease;
	}
	html.light .page-bg {
		background: radial-gradient(125% 125% at 50% 30%, #fafaf9 40%, #c4b5fd 100%);
	}

	/* ── Fotos que se abren a pantalla completa ── */
	img[data-zoomable] {
		cursor: zoom-in;
	}
	img[data-zoomable]:hover {
		filter: brightness(1.08);
		box-shadow: 0 0 0 2px rgb(250 204 21 / 0.7), 0 10px 30px rgb(102 51 238 / 0.4);
	}
	img[data-zoomable]:focus-visible {
		outline: 2px solid rgb(250 204 21);
		outline-offset: 3px;
	}

	/* ── Aparición al hacer scroll ── */
	[data-reveal] {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}
	[data-reveal].is-revealed {
		opacity: 1;
		transform: none;
	}

	/* ── Modo claro: ajustes de color sobre las clases que usa el sitio ── */
	html.light body {
		color: #1f2937;
	}
	html.light .text-white:not(a):not(button):not(.tag-pill):not(.lightbox *):not(.carousel *) {
		color: #111827;
	}
	html.light .text-gray-200 { color: #1f2937; }
	html.light .text-gray-300 { color: #374151; }
	html.light .text-white\/80 { color: #4b5563; }
	html.light .text-yellow-400,
	html.light .text-yellow-500 { color: #b45309; }
	html.light .border-gray-700 { border-color: #d1d5db; }
	html.light .wip-note { color: #78350f; }
	html.light .wip-badge { color: #92400e; }
	html.light .bg-white\/5 { background-color: rgb(0 0 0 / 0.05); }
	html.light .border-white\/10 { border-color: rgb(0 0 0 / 0.12); }
	html.light .section-arrow,
	html.light .project-arrow { color: #b45309; }

	/* Transición suave de colores al cambiar de tema */
	html.theme-transition,
	html.theme-transition * {
		transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease !important;
	}

	html {
		font-family: "Onest Variable", system-ui, sans-serif;
		box-sizing: border-box;
		scroll-behavior: smooth; /* animacion scroll */ 
	}
	
	body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 100vh;

	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		[data-reveal] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

</style>
