---
import Badge from '../components/Badge.astro';
import SocialPill from '../components/SocialPill.astro';
import SectionContainer from '../components/SectionContainer.astro';
import GithubIcon from '../icons/Github.astro';
import LinkeInIcon from "../icons/LinkedIn.astro"
import MailIcon from '../icons/Mail.astro';
import Layout from '../layouts/Layout.astro';
import Experience from '../components/Experience.astro';
import WorkIcon from '../icons/Work.astro';
import CodeIcon from '../icons/Code.astro'
import Projects from '../components/Projects.astro';
import ProfileCheck from '../icons/ProfileCheck.astro';
import AboutMe from '../components/AboutMe.astro';
---

<Layout title="Porfolio Martín Castro - Desarrollador y Programador Web Full Stack">
	<main class="px-4">
		<SectionContainer id="top" class="py-4 mt-16 sm:py-0 max-w-5xl mx-auto section-animation relative" data-section>
			<!-- Fondo animado del inicio: manchas de color que flotan suavemente -->
			<div class="hero-bg" aria-hidden="true">
				<span class="blob blob-1"></span>
				<span class="blob blob-2"></span>
				<span class="blob blob-3"></span>
			</div>
			<div class="flex gap-3 mb-4 pr-5">
				<img
					class="object-fill rounded-[3rem] w-36 h-40 md:w-40 md:h-48 p-1 md:p-3 ring-1 ring-black/70 [background:radial-gradient(125%_125%_at_50%_30%,#000_40%,#63e_100%)]"
					src="/pictures/Photo-me-01.webp" 
					alt="My-photo"
				/>
				<a
				href="https://www.linkedin.com/in/martin-daniel-castro"
				target="_blank" 
				class="flex items-center justify-center pt-28" >
					<Badge>Disponible para Trabajar</Badge>
				</a>
			</div>
			<h1 
				data-reveal data-reveal-delay="100"
				class="text-2xl sm:text-4xl md:text-5xl font-bold flex flex-row gap-x-4 pb-5"
			>¡Hola! Soy Martin Castro
			</h1>
				<h2 class="text-base md:text-xl lg:text-2xl opacity-80 text-pretty" data-reveal data-reveal-delay="250">
					<span class="text-yellow-400" >
						Desarrollador Web Full Stack
					</span> con experiencia en crear soluciones digitales y eficientes. Transformo ideas en sitios funcionales, optimizados pensando en una excelente experiencia de usuario. 
				</h2>
			<nav class="md:flex gap-x-5 mt-5" data-reveal data-reveal-delay="400">
				<SocialPill href="https://github.com/Drake4044">
					<GithubIcon class="size-8"/>
					Github
				</SocialPill>
				<SocialPill href="https://www.linkedin.com/in/martin-daniel-castro">
					<LinkeInIcon class="size-7 fill-white group-hover:fill-yellow-400 "/>
					LinkedIn
				</SocialPill>
				<SocialPill href="mailto:martincastro4044@gmail.com" id="mail">
					<MailIcon class="size-8"/>
					martincastro4044@gmail.com
				</SocialPill>
			</nav>
		</SectionContainer>

		<!-- Contenedor para la flecha y el espacio entre secciones -->
		<div class="relative h-16 md:h-16 md:-mb-16 md:translate-y-7">
			<div class="section-arrow absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2">
				<svg 
					xmlns="http://www.w3.org/2000/svg" 
					class="icon icon-tabler icon-tabler-arrow-down" 
					width="24" 
					height="24" 
					viewBox="0 0 24 24" 
					stroke-width="2" 
					stroke="currentColor" 
					fill="none" 
					stroke-linecap="round" 
					stroke-linejoin="round"
				>
					<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
					<path d="M12 5l0 14" />
					<path d="M18 13l-6 6" />
					<path d="M6 13l6 6" />
				</svg>
			</div>
		</div>

		<SectionContainer id="experiencia" class="pt-6 md:pt-28 max-w-5xl mx-auto" >
			<h2 class="text-3xl font-bold mb-8 flex items-center gap-x-3 section-title" data-reveal>
				<WorkIcon class="size-8" />
				Experiencia
			</h2>
			<Experience/>
		</SectionContainer>

		<!-- Contenedor para la flecha entre experiencia y proyectos -->
		<div class="relative h-20 md:h-16 md:-mb-16 md:translate-y-4">
			<div class="section-arrow absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2">
				<svg 
					xmlns="http://www.w3.org/2000/svg" 
					class="icon icon-tabler icon-tabler-arrow-down" 
					width="24" 
					height="24" 
					viewBox="0 0 24 24" 
					stroke-width="2" 
					stroke="currentColor" 
					fill="none" 
					stroke-linecap="round" 
					stroke-linejoin="round"
				>
					<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
					<path d="M12 5l0 14" />
					<path d="M18 13l-6 6" />
					<path d="M6 13l6 6" />
				</svg>
			</div>
		</div>

		<SectionContainer id="proyectos" class="pt-8 md:pt-28 max-w-5xl mx-auto" >
			<h2 class="text-3xl font-bold mb-8 flex items-center gap-x-3 section-title" data-reveal>
				<CodeIcon class="size-8" />
				Proyectos
			</h2>
			<Projects/>
		</SectionContainer>

		<!-- Contenedor para la flecha entre proyectos y sobre-mi -->
		<div class="relative h-20 md:h-16 md:-mb-16 md:translate-y-7">
			<div class="section-arrow absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2">
				<svg 
					xmlns="http://www.w3.org/2000/svg" 
					class="icon icon-tabler icon-tabler-arrow-down" 
					width="24" 
					height="24" 
					viewBox="0 0 24 24" 
					stroke-width="2" 
					stroke="currentColor" 
					fill="none" 
					stroke-linecap="round" 
					stroke-linejoin="round"
				>
					<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
					<path d="M12 5l0 14" />
					<path d="M18 13l-6 6" />
					<path d="M6 13l6 6" />
				</svg>
			</div>
		</div>

		<SectionContainer id="sobre-mi" class="pt-8 md:pt-28 max-w-5xl mx-auto" >
			<h2 class="text-3xl font-bold mb-8 flex items-center gap-x-3 section-title" data-reveal>
				<ProfileCheck class="size-8" />
				Sobre mi
			</h2>
			<AboutMe/>
		</SectionContainer>
	</main>
</Layout>

<style>
	img {
		mask-image: linear-gradient(
			black 30%,
			transparent
		);
	}

	/* ── Fondo animado del inicio ── */
	.hero-bg {
		position: absolute;
		inset: -4rem 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		filter: blur(60px);
		opacity: 0.55;
	}
	.blob {
		position: absolute;
		border-radius: 9999px;
		mix-blend-mode: screen;
		animation: blob-float 18s ease-in-out infinite;
	}
	.blob-1 { width: 18rem; height: 18rem; top: 5%; left: 10%; background: #6633ee; }
	.blob-2 { width: 14rem; height: 14rem; top: 35%; right: 5%; background: #facc15; opacity: 0.35; animation-delay: -6s; animation-duration: 22s; }
	.blob-3 { width: 16rem; height: 16rem; bottom: 0; left: 40%; background: #ec4899; opacity: 0.4; animation-delay: -12s; animation-duration: 26s; }
	@keyframes blob-float {
		0%, 100% { transform: translate(0, 0) scale(1); }
		33% { transform: translate(40px, -30px) scale(1.1); }
		66% { transform: translate(-30px, 25px) scale(0.92); }
	}
	:global(html.light) .hero-bg { opacity: 0.35; }
	:global(html.light) .blob { mix-blend-mode: multiply; }

	/* Línea amarilla que crece debajo de cada título de sección */
	.section-title {
		position: relative;
		padding-bottom: 0.5rem;
	}
	.section-title::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: 0;
		height: 3px;
		width: 0;
		border-radius: 9999px;
		background: linear-gradient(90deg, rgb(250 204 21), rgb(102 51 238));
		transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
	}
	.section-title.is-revealed::after {
		width: 4rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.blob { animation: none; }
	}

	@keyframes floatingArrow {
        0%, 100% { transform: translate(-50%, -50%); }
        50% { transform: translate(-50%, calc(-50% + 10px)); }
    }

    @keyframes hideArrow {
        0% { 
            transform: translate(-50%, -50%);
            opacity: 1;
        }
        50% { 
            transform: translate(-50%, calc(-50% - 20px));
            opacity: 0.5;
        }
        100% { 
            transform: translate(-50%, calc(-50% - 30px));
            opacity: 0;
        }
    }

    @keyframes showArrow {
        0% { 
            transform: translate(-50%, calc(-50% - 30px));
            opacity: 0;
        }
        50% { 
            transform: translate(-50%, calc(-50% - 20px));
            opacity: 0.5;
        }
        100% { 
            transform: translate(-50%, -50%);
            opacity: 1;
        }
    }

    .section-arrow {
        animation: floatingArrow 1.5s ease-in-out infinite;
        color: rgb(250 204 21);
        opacity: 1;
        transition: none;
    }

    .section-arrow.hiding {
        animation: hideArrow 0.8s ease-in-out forwards;
    }

    .section-arrow.showing {
        animation: showArrow 0.8s ease-in-out forwards;
    }
</style>

<script>
	// Control dinámico de todas las flechas entre secciones
    const sectionArrows = document.querySelectorAll('.section-arrow');
    const hiddenStates = new Map();

    sectionArrows.forEach((arrow, index) => {
        if (arrow instanceof HTMLElement) {
            hiddenStates.set(arrow, false);
            
            const checkArrowVisibility = () => {
                const sections = Array.from(document.querySelectorAll('section'));
                if (index >= sections.length - 1) return;

                const currentSection = sections[index];
                const nextSection = sections[index + 1];
                
                if (currentSection && nextSection) {
                    const currentRect = currentSection.getBoundingClientRect();
                    const nextRect = nextSection.getBoundingClientRect();
                    
                    // Calcular el porcentaje visible de la siguiente sección
                    const nextSectionVisiblePercentage = (window.innerHeight - nextRect.top) / window.innerHeight * 100;
                    const isHidden = hiddenStates.get(arrow);
                    
                    if (nextSectionVisiblePercentage >= 40 && !isHidden) {
                        hiddenStates.set(arrow, true);
                        arrow.classList.remove('showing');
                        arrow.classList.add('hiding');
                        setTimeout(() => {
                            arrow.style.display = 'none';
                        }, 800);
                    } else if (nextSectionVisiblePercentage < 40 && isHidden) {
                        arrow.style.display = 'flex';
                        arrow.classList.remove('hiding');
                        arrow.classList.add('showing');
                        setTimeout(() => {
                            arrow.classList.remove('showing');
                        }, 800);
                        hiddenStates.set(arrow, false);
                    }
                }
            };

            window.addEventListener('scroll', () => {
                requestAnimationFrame(() => checkArrowVisibility());
            });

            // Verificar al cargar la página
            checkArrowVisibility();
        }
    });
</script>

